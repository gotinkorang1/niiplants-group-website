# Copy to .env.local and fill in before launch.

# Real production domain — drives canonical URLs, sitemap, robots, OG tags.
NEXT_PUBLIC_SITE_URL=https://niiplantsgroup.com

# Contact form (Resend) — form returns a graceful fallback until these are set.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: verified sender, e.g. "Niiplants Group <no-reply@niiplantsgroup.com>"
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile bot protection (free) — dash.cloudflare.com -> Turnstile.
# Both optional: the form works without them (honeypot + timing checks only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
